<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 
         http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>com.github.andrestubbe</groupId>
    <artifactId>FastGrab</artifactId>
    <version>0.1.0</version>
    <packaging>jar</packaging>

    <name>FastGrab</name>
    <description>Ultra-fast uncompressed screen capture CLI and global hotkey daemon for Java</description>
    <url>https://github.com/andrestubbe/FastGrab</url>

    <properties>
        <maven.compiler.source>17</maven.compiler.source>
        <maven.compiler.target>17</maven.compiler.target>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    </properties>

    <licenses>
        <license>
            <name>MIT License</name>
            <url>https://opensource.org/licenses/MIT</url>
            <distribution>repo</distribution>
        </license>
    </licenses>

    <developers>
        <developer>
            <name>Andre Stubbe</name>
            <organization>FastJava</organization>
            <organizationUrl>https://github.com/andrestubbe</organizationUrl>
        </developer>
    </developers>

    <scm>
        <connection>scm:git:git://github.com/andrestubbe/FastGrab.git</connection>
        <developerConnection>scm:git:ssh://github.com:andrestubbe/FastGrab.git</developerConnection>
        <url>https://github.com/andrestubbe/FastGrab/tree/main</url>
    </scm>

    <repositories>
        <repository>
            <id>jitpack.io</id>
            <url>https://jitpack.io</url>
        </repository>
    </repositories>

    <dependencies>
        <!-- FastCore - Unified native loader -->
        <dependency>
            <groupId>com.github.andrestubbe</groupId>
            <artifactId>FastCore</artifactId>
            <version>0.1.0</version>
        </dependency>

        <!-- FastScreen - DXGI Desktop Duplication 240+ FPS -->
        <dependency>
            <groupId>com.github.andrestubbe</groupId>
            <artifactId>FastScreen</artifactId>
            <version>0.1.2</version>
        </dependency>

        <!-- FastHotkey - Low-Latency Global Windows Hotkeys -->
        <dependency>
            <groupId>com.github.andrestubbe</groupId>
            <artifactId>fasthotkey</artifactId>
            <version>0.1.0</version>
        </dependency>

        <!-- FastImage - Zero-Copy Frame Container & SIMD Filters -->
        <dependency>
            <groupId>com.github.andrestubbe</groupId>
            <artifactId>FastImage</artifactId>
            <version>0.1.2</version>
        </dependency>

        <!-- JUnit 5 for testing -->
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <version>5.10.0</version>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <version>3.11.0</version>
                <configuration>
                    <source>17</source>
                    <target>17</target>
                </configuration>
            </plugin>
            <!-- Exec Plugin for Easy CLI Run -->
            <plugin>
                <groupId>org.codehaus.mojo</groupId>
                <artifactId>exec-maven-plugin</artifactId>
                <version>3.1.0</version>
                <configuration>
                    <mainClass>fastgrab.FastGrab</mainClass>
                </configuration>
            </plugin>
        </plugins>
    </build>
</project>
